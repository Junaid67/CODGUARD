# Backend API base URL (NestJS). Include the /api/v1 prefix.
# Relative path — Vite's dev server proxies /api/* to the backend (see
# vite.config.ts), so this works at localhost:5173 and through the Shopify
# CLI tunnel alike. Only use an absolute URL if running the frontend without
# the Vite proxy in front of it (e.g. a separate static deploy).
VITE_API_URL=/api/v1

# Shopify app Client ID (API key) — same as the backend's SHOPIFY_API_KEY.
# Injected into index.html for App Bridge.
VITE_SHOPIFY_API_KEY=bc6e84eda93cbd4d158a8174ac09eb4c
