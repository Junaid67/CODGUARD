# App
NODE_ENV=development
PORT=5000
APP_URL=https://yourapp.com
CORS_WHITELIST=https://yourapp.com,https://admin.shopify.com

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_customers,write_orders,read_fulfillments,write_tags

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cod_risk_scorer
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=
HASH_SECRET=

# Session
SESSION_SECRET=
